[Unit]
Description=Agent Root Runner Daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/agent-root-runner-daemon --socket /run/agent-root-runner/runner.sock --audit-log /var/log/agent-root-runner/audit.log
User=root
Group=wheel
RuntimeDirectory=agent-root-runner
RuntimeDirectoryMode=0750
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
